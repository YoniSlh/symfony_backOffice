{% extends 'base.html.twig' %}

{% block body %}
	<h1 class="text-2xl font-bold mb-6">Modifier un produit</h1>

	{{ form_start(form) }}
	<div class="space-y-4">
		<div>
			<label for="product_name" class="block text-sm font-medium text-gray-700">Nom</label>
			{{ form_widget(form.name) }}
		</div>
		<div>
			<label for="product_description" class="block text-sm font-medium text-gray-700">Description</label>
			{{ form_widget(form.description) }}
		</div>
		<div>
			<label for="product_price" class="block text-sm font-medium text-gray-700">Prix</label>
			{{ form_widget(form.price) }}
		</div>
	</div>
	<button type="submit" class="mt-4 py-2 px-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Modifier</button>
	{{ form_end(form) }}

	<a href="{{ path('admin_products') }}" class="mt-4 inline-block text-blue-600">Retour à la liste des produits</a>
{% endblock %}
