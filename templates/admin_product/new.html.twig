{% extends 'base.html.twig' %}

{% block title %}Ajout | Produits
{% endblock %}
{% block body %}
	<div class="max-w-lg mx-auto mt-10 bg-white p-6 rounded-xl shadow-lg">
		<h1 class="text-2xl font-bold mb-6 text-gray-800">Ajouter un produit</h1>

		{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

		<div>
			<label class="block text-gray-700 font-medium">Nom</label>
			{{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring focus:ring-blue-300'}}) }}
		</div>

		<div>
			<label class="block text-gray-700 font-medium">Description</label>
			{{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring focus:ring-blue-300'}}) }}
		</div>

		<div>
			<label class="block text-gray-700 font-medium">Prix</label>
			{{ form_widget(form.price, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring focus:ring-blue-300'}}) }}
		</div>

		<button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition" onclick="return confirm('Êtes-vous sûr de vouloir ajouter ce produit ?');">
			Ajouter
		</button>

		{{ form_end(form) }}

		<a href="{{ path('admin_products') }}" class="block text-center mt-4 text-blue-600 hover:underline">Retour à la liste des produits</a>
	</div>
{% endblock %}
