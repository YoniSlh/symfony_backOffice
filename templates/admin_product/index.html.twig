{% extends 'base.html.twig' %}

{% block title %}Produits
{% endblock %}
{% block body %}
	<div class="max-w-5xl mx-auto mt-10 bg-white p-6 rounded-xl shadow-lg">
		<h1 class="text-2xl font-bold mb-6 text-gray-800">Gestion des produits</h1>

		{% if is_granted('ROLE_ADMIN') %}
			<div class="mb-4">
				<a href="{{ path('admin_products_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
					Ajouter un produit
				</a>
			</div>
		{% endif %}

		<div class="mb-4">
			{% if currentSort == 'price_desc' %}
				<a href="{{ path('admin_products', { 'sort': 'price_asc' }) }}" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition">
					Trier par prix croissant
				</a>
			{% else %}
				<a href="{{ path('admin_products', { 'sort': 'price_desc' }) }}" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition">
					Trier par prix décroissant
				</a>
			{% endif %}
		</div>

		<div class="overflow-x-auto">
			<table class="w-full border border-gray-300 rounded-lg shadow">
				<thead class="bg-gray-100">
					<tr class="text-left">
						<th class="px-4 py-2 border-b">Nom</th>
						<th class="px-4 py-2 border-b">Description</th>
						<th class="px-4 py-2 border-b">Prix</th>
						{% if is_granted('ROLE_ADMIN') %}
							<th class="px-4 py-2 border-b">Actions</th>
						{% endif %}
					</tr>
				</thead>
				<tbody>
					{% for product in products %}
						<tr class="hover:bg-gray-50">
							<td class="px-4 py-2 border-b">{{ product.name }}</td>
							<td class="px-4 py-2 border-b">{{ product.description }}</td>
							<td class="px-4 py-2 border-b">{{ product.price }}
								€
							</td>
							{% if is_granted('ROLE_ADMIN') %}
								<td class="px-4 py-2 border-b flex space-x-2">
									<a href="{{ path('admin_products_edit', {'id': product.id}) }}" class="bg-green-500 text-white px-3 py-1 rounded-lg hover:bg-green-600 transition">
										Modifier
									</a>
									<form action="{{ path('admin_products_delete', {'id': product.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
										<button type="submit" class="bg-red-500 text-white px-3 py-1 rounded-lg hover:bg-red-600 transition">
											Supprimer
										</button>
									</form>
								</td>
							{% endif %}
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		<br>
		{# <div class="mb-4">
			<form action="" method="post" enctype="multipart/form-data">
				<label class="block text-gray-700 font-medium">Importer CSV</label>
				<input type="file" name="csv_file" accept=".csv" class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none">
			</form>
		</div> #}
		<div class="mb-4">
			<a href="{{ path('admin_products_export') }}" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
				Export CSV
			</a>
		</div>
	</div>
{% endblock %}
