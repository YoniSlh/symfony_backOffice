<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}BackOffice
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> {% block stylesheets %}{% endblock %}
		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body class="bg-gray-100 text-gray-900">
		{% for type, messages in app.flashes %}
			{% for message in messages %}
				<div class="bg-green-500 text-white p-4">
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		<div class="flex h-screen">
			<nav class="w-64 bg-white shadow-md">
				<div class="p-4 border-b">
					<h1 class="text-xl font-bold text-gray-800">Backoffice</h1>
				</div>
				<ul class="space-y-2 p-4">
					<li>
						<a href="{{ path('home') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-200 rounded-lg">Accueil</a>
					</li>
					{% if is_granted('ROLE_ADMIN') %}
						<li>
							<a href="{{ path('admin_users') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-200 rounded-lg">Utilisateurs</a>
						</li>
					{% endif %}
					{% if app.user %}
						<li>
							<a href="{{ path('admin_products') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-200 rounded-lg">Produits</a>
						</li>
					{% endif %}
					{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
						<li>
							<a href="{{ path('admin_clients') }}" class="block px-4 py-2 text-gray-700 hover:bg-gray-200 rounded-lg">Clients</a>
						</li>
					{% endif %}
				</ul>

				<div class="p-4">
					{% if app.user %}
						<form method="post" action="{{ path('app_logout') }}">
							<button type="submit" class="w-full py-2 bg-red-600 text-white rounded-lg" onclick="return confirm('Êtes-vous sûr de vouloir vous déconnecter ?');">Déconnexion</button>
						</form>
					{% else %}
						<a href="{{ path('app_login') }}" class="block w-full py-2 px-4 bg-blue-600 text-white rounded-lg text-center">Se connecter</a>
					{% endif %}
				</div>
			</nav>

			<main class="flex-1 p-6"> {% block body %}{% endblock %}
				</main>
			</div>
		</body>
	</html>
