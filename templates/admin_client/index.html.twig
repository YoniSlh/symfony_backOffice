{% extends 'base.html.twig' %}

{% block title %}Clients
{% endblock %}
{% block body %}
	<div class="max-w-5xl mx-auto mt-10 bg-white p-6 rounded-xl shadow-lg">
		<h1 class="text-2xl font-bold mb-6 text-gray-800">Gestion des clients</h1>

		<div class="mb-4">
			<a href="{{ path('admin_clients_new') }}" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
				Ajouter un client
			</a>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full border border-gray-300 rounded-lg shadow">
				<thead class="bg-gray-100">
					<tr class="text-left">
						<th class="px-4 py-2 border-b">Prénom</th>
						<th class="px-4 py-2 border-b">Nom</th>
						<th class="px-4 py-2 border-b">Email</th>
						<th class="px-4 py-2 border-b">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for client in clients %}
						<tr class="hover:bg-gray-50">
							<td class="px-4 py-2 border-b">{{ client.firstname }}</td>
							<td class="px-4 py-2 border-b">{{ client.lastname }}</td>
							<td class="px-4 py-2 border-b">{{ client.email }}</td>
							<td class="px-4 py-2 border-b flex space-x-2">
								<a href="{{ path('admin_clients_edit', {id: client.id}) }}" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
									Modifier
								</a>
								<form action="{{ path('admin_clients_delete', {id: client.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce client ?')">
									<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
									<button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-opacity-50">
										Supprimer
									</button>
								</form>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
