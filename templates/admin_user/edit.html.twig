{% extends 'base.html.twig' %}

{% block body %}
	<div class="max-w-lg mx-auto mt-10 bg-white p-6 rounded-xl shadow-lg">
		<h1 class="text-2xl font-bold mb-6 text-gray-800">Modifier un utilisateur</h1>

		{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}

		<div>
			<label class="block text-gray-700 font-medium">Email</label>
			{{ form_widget(form.email, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring focus:ring-green-300'}}) }}
		</div>

		<div>
			<label class="block text-gray-700 font-medium">Prénom</label>
			{{ form_widget(form.firstname, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring focus:ring-green-300'}}) }}
		</div>

		<div>
			<label class="block text-gray-700 font-medium">Nom</label>
			{{ form_widget(form.lastname, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring focus:ring-green-300'}}) }}
		</div>

		<div>
			<label class="block text-gray-700 font-medium">Rôles</label>
			{{ form_widget(form.roles, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring focus:ring-green-300'}}) }}
		</div>

		<button type="submit" class="w-full bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
			Modifier
		</button>

		{{ form_end(form) }}

		<a href="{{ path('admin_users') }}" class="block text-center mt-4 text-blue-600 hover:underline">Retour</a>
	</div>
{% endblock %}
