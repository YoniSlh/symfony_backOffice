{% extends 'base.html.twig' %}

{% block title %}BackOffice{% endblock %}

{% block body %}
    <div class="text-center p-8">
        {% if app.user %}
            <h1 class="text-3xl font-semibold text-gray-800">Bonjour, {{ app.user.firstname }} 👋</h1>
            <p class="text-gray-600 mt-2">Vous êtes connecté en tant que <b>{{ app.user.userIdentifier }}</b>.</p>
        {% else %}
            <h1 class="text-3xl font-semibold text-gray-800">Non connecté</h1>
            <p class="text-gray-600 mt-2"><i>Veuillez vous connecter pour avoir accès au site.</i></p>
            <a href="{{ path('app_login') }}" class="text-orange-600 hover:underline mt-4 inline-block">Se connecter</a>
        {% endif %}
    </div>
{% endblock %}