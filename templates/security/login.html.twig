{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}
	<form method="post" class="max-w-sm mx-auto bg-white p-6 rounded-lg shadow-lg">
		{% if error %}
			<div class="text-red-500 mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
		{% endif %}

		{% if app.user %}
			<div class="mb-3">
				Bonjour,
				{{ app.user.firstname }}
				👋<br>Vous êtes connecté en tant que
				<b>{{ app.user.userIdentifier }}</b>
			</div>
		{% endif %}

		<h1 class="text-2xl font-bold mb-6 text-center text-gray-800">Se connecter</h1>

		<label for="inputEmail" class="block text-gray-700 font-medium">Email</label>
		<input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" autocomplete="email" required autofocus>

		<label for="inputPassword" class="block text-gray-700 font-medium mt-4">Mot de passe</label>
		<input type="password" name="password" id="inputPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" autocomplete="current-password" required>

		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

		<button class="w-full mt-6 py-2 px-4 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300" type="submit">
			Se connecter
		</button>
	</form>

	<div class="mt-4 text-center">
		<p class="text-gray-600">Pas encore inscrit ?
			<a href="{{ path('app_register') }}" class="text-blue-600 hover:underline">S'inscrire</a>
		</p>
	</div>
{% endblock %}
